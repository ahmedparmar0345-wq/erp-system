# Database (individual settings - fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp

# Database (Render Postgres connection string - preferred)
DATABASE_URL=postgres://user:password@host:5432/erp

# Server
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=7d